#!/bin/bash

set -euo pipefail

# ============================================================
# GitHub PR Dashboard
#
# Requirements:
#   gh (logged in), jq, git, perl
#   Windows: run from Git Bash (ships bash, git and perl)
#
# Usage (as a gh extension, or directly as gh-dashboard):
#   gh dashboard
#   gh dashboard --all
#   gh dashboard --mine
#   gh dashboard --review
#   gh dashboard --author alice[,bob...]
#   gh dashboard --author-list
#   gh dashboard --verbose
#
# Environment:
#   GH_DASHBOARD_LIMIT=200
#   GH_DASHBOARD_BATCH=20
#   GH_DASHBOARD_PROGRESS=0  hide the progress bar (1: show it even when piped)
#   NO_COLOR=1           disable colors and links
#   CLICOLOR_FORCE=1     keep colors when piping (e.g. to less -R)
#
# Docs: https://github.com/BenSagir/gh-dashboard
# ============================================================

VERSION="1.4.2"


# ------------------------------------------------------------
# Windows
#
# jq.exe writes CRLF line endings. A trailing \r breaks
# comparisons ("true\r" != "true"), titles and the paging
# cursor, so strip it. Only defined on Windows shells.
# ------------------------------------------------------------

case "$(uname -s)" in
    MINGW*|MSYS*|CYGWIN*)
        jq() { command jq "$@" | tr -d '\r'; }
        ;;
esac


# ------------------------------------------------------------
# Configuration
# ------------------------------------------------------------

LIMIT="${GH_DASHBOARD_LIMIT:-200}"
BATCH="${GH_DASHBOARD_BATCH:-20}"

for SETTING in "GH_DASHBOARD_LIMIT=$LIMIT" "GH_DASHBOARD_BATCH=$BATCH"; do
    if ! [[ "${SETTING#*=}" =~ ^[1-9][0-9]*$ ]]; then
        echo "Invalid ${SETTING%%=*}: '${SETTING#*=}' (must be a positive number)" >&2
        exit 1
    fi
done

# ------------------------------------------------------------
# Options
# ------------------------------------------------------------

FILTER="all"
FILTER_OPTION=""
AUTHORS=""
VERBOSE=0
AUTHOR_LIST=0

usage_error() {
    echo "$1" >&2
    echo "Use --help for usage." >&2
    exit 1
}

# Only one of --all/--mine/--review/--author per run.
set_filter() {
    if [[ -n "$FILTER_OPTION" ]]; then
        usage_error "Use only one of --all, --mine, --review, --author (got $FILTER_OPTION and $2)"
    fi
    FILTER="$1"
    FILTER_OPTION="$2"
}

while [[ $# -gt 0 ]]; do

    case "$1" in

    --mine)
        set_filter mine "$1"
        ;;
    --review)
        set_filter review "$1"
        ;;
    --all)
        set_filter all "$1"
        ;;
    --author)
        if [[ $# -lt 2 || "$2" == -* ]]; then
            usage_error "--author needs a name, e.g. --author octocat"
        fi
        set_filter author "$1"
        AUTHORS="$2"
        shift
        ;;
    --author=*)
        set_filter author "--author"
        AUTHORS="${1#*=}"
        [[ -n "$AUTHORS" ]] || usage_error "--author needs a name, e.g. --author octocat"
        ;;
    --author-list)
        AUTHOR_LIST=1
        ;;
    --verbose)
        VERBOSE=1
        ;;
    --help|-h)
        cat <<EOF

GitHub PR Dashboard

Usage:
  gh dashboard                  All open PRs
  gh dashboard --mine           PRs authored by you
  gh dashboard --review         PRs you are a reviewer on (requested or reviewed)
  gh dashboard --author NAME    PRs authored by NAME (several: alice,bob)
  gh dashboard --all            Same as default
  gh dashboard --author-list    List the authors of open PRs, with counts
  gh dashboard --verbose        Show search totals and each fetch step
  gh dashboard --version        Print version

--author-list and --verbose can be combined with the filters above,
e.g. gh dashboard --review --author-list.

Run it inside a clone of a GitHub repository.

Environment:
  GH_DASHBOARD_LIMIT=200    Max PRs to show
  GH_DASHBOARD_BATCH=20     PRs per API request (lower if you get 504s)
  GH_DASHBOARD_PROGRESS=0   Hide the progress bar (1: show even when piped)
  NO_COLOR=1                Disable colors and clickable links
  CLICOLOR_FORCE=1          Keep colors when output is piped

Docs: https://github.com/BenSagir/gh-dashboard

EOF
        exit 0
        ;;
    --version|-v)
        echo "gh-dashboard $VERSION"
        exit 0
        ;;
    *)
        usage_error "Unknown option: $1"
        ;;

    esac

    shift

done


# ------------------------------------------------------------
# --author NAME[,NAME...] -> search qualifiers
#
# Several author: qualifiers are ORed by GitHub search. Each
# name is also searched as app/NAME, because bots show up as
# "dependabot" but only match author:app/dependabot.
# A leading @ is dropped (except @me), and a [bot] suffix is
# accepted. Names are checked so they can't inject other
# search qualifiers.
# ------------------------------------------------------------

AUTHOR_QUALIFIERS=""

if [[ "$FILTER" == "author" ]]; then

    IFS=',' read -ra AUTHOR_NAMES <<< "$AUTHORS"

    for NAME in ${AUTHOR_NAMES[@]+"${AUTHOR_NAMES[@]}"}; do

        [[ -z "$NAME" ]] && continue

        if [[ "$NAME" == "@me" ]]; then
            AUTHOR_QUALIFIERS="$AUTHOR_QUALIFIERS author:@me"
            continue
        fi

        NAME="${NAME#@}"
        NAME="${NAME%\[bot\]}"

        if ! [[ "$NAME" =~ ^[A-Za-z0-9][A-Za-z0-9_-]*$ ]]; then
            usage_error "Invalid author name: '$NAME' (letters, numbers, - and _ only)"
        fi

        AUTHOR_QUALIFIERS="$AUTHOR_QUALIFIERS author:$NAME author:app/$NAME"

    done

    [[ -n "$AUTHOR_QUALIFIERS" ]] || usage_error "--author needs a name, e.g. --author octocat"

fi


# ------------------------------------------------------------
# Colors
#
# On when stdout is a terminal. NO_COLOR (https://no-color.org)
# turns them off; CLICOLOR_FORCE turns them on even when piped.
# Clickable links follow the same rule.
# ------------------------------------------------------------

USE_COLOR=0

if [[ -n "${NO_COLOR:-}" ]]; then
    USE_COLOR=0
elif [[ -n "${CLICOLOR_FORCE:-}" && "${CLICOLOR_FORCE}" != "0" ]]; then
    USE_COLOR=1
elif [[ -t 1 ]]; then
    USE_COLOR=1
fi

if [[ "$USE_COLOR" == 1 ]]; then

    RESET=$'\033[0m'
    BOLD=$'\033[1m'
    DIM=$'\033[2m'

    RED=$'\033[31m'
    GREEN=$'\033[32m'
    YELLOW=$'\033[33m'
    ORANGE=$'\033[38;5;208m'
    CYAN=$'\033[36m'

else

    RESET=""
    BOLD=""
    DIM=""

    RED=""
    GREEN=""
    YELLOW=""
    ORANGE=""
    CYAN=""

fi


# ------------------------------------------------------------
# Terminal hyperlink
#
# OSC 8 works in iTerm2, Windows Terminal and most modern terminals.
# ------------------------------------------------------------

link()
{
    local url="$1"
    local text="$2"

    if [[ "$USE_COLOR" == 1 ]]; then
        printf '\033]8;;%s\a%s\033]8;;\a' "$url" "$text"
    else
        printf '%s' "$text"
    fi
}


# ------------------------------------------------------------
# Table row
#
# Bash 3.2 printf pads by bytes, so colors, links and symbols
# like ✓ throw columns off. This pads/truncates each cell by
# its visible width instead (escape codes = 0, emoji = 2).
#
# Usage: row CELL...   (widths come from COL_WIDTHS)
# ------------------------------------------------------------

COL_WIDTHS="6,34,14,30,10,11,12"

row()
{
    perl -CSA -e '
        my @widths = split /,/, shift @ARGV;
        my $esc = qr/\e\[[0-9;]*m|\e\]8;;[^\a]*\a/;

        sub cw {
            my $c = shift;
            return 0 if $c =~ /^\p{M}/;
            return 2 if $c =~ /[\x{1100}-\x{115F}\x{2E80}-\x{A4CF}\x{AC00}-\x{D7A3}\x{F900}-\x{FAFF}\x{FF00}-\x{FF60}\x{1F300}-\x{1FAFF}]/;
            return 1;
        }

        my @cells;
        for my $i (0 .. $#widths) {
            my $s   = $ARGV[$i] // "";
            my $max = $widths[$i];

            (my $plain = $s) =~ s/$esc//g;
            my $total = 0;
            $total += cw($_) for $plain =~ /\X/g;
            my $limit = $total > $max ? $max - 1 : $max;

            my ($out, $vis, $cut) = ("", 0, 0);
            while ($s =~ /\G($esc|\X)/gc) {
                my $t = $1;
                if ($t =~ /^\e/) { $out .= $t; next }
                next if $cut;
                my $w = cw($t);
                if ($vis + $w > $limit) { $out .= "\x{2026}"; $vis++; $cut = 1; next }
                $out .= $t;
                $vis += $w;
            }

            $out .= " " x ($max - $vis) if $vis < $max;
            push @cells, $out;
        }

        print join(" ", @cells), "\n";
    ' "$COL_WIDTHS" "$@"
}


# ------------------------------------------------------------
# Current repository
# ------------------------------------------------------------

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then

    echo
    echo "${RED}Not inside a git repository.${RESET}"
    echo
    echo "Run this command from a cloned GitHub repository."
    echo

    exit 1

fi

REPO_ERROR=""

if ! REPO=$(gh repo view --json nameWithOwner --jq '.nameWithOwner' 2>&1); then
    REPO_ERROR="$REPO"
    REPO=""
fi


# ------------------------------------------------------------
# The active gh account may not have access to this repo
# (e.g. work account active, personal private repo).
# Try the other logged-in accounts; the first one that can
# see the repo is used for the rest of this run only, via
# GH_TOKEN, so the global `gh auth` setting is not changed.
# ------------------------------------------------------------

if [[ -z "$REPO" ]]; then

    ACCOUNTS=$(gh auth status --json hosts \
        --jq '.hosts["github.com"][]? | select(.active | not) | .login' \
        2>/dev/null || true)

    for ACCOUNT in $ACCOUNTS; do

        ACCOUNT_TOKEN=$(gh auth token --user "$ACCOUNT" 2>/dev/null || true)
        [[ -z "$ACCOUNT_TOKEN" ]] && continue

        REPO=$(GH_TOKEN="$ACCOUNT_TOKEN" gh repo view \
            --json nameWithOwner \
            --jq '.nameWithOwner' 2>/dev/null || true)

        if [[ -n "$REPO" ]]; then
            export GH_TOKEN="$ACCOUNT_TOKEN"
            break
        fi

    done

fi

if [[ -z "$REPO" ]]; then

    echo
    echo "${RED}Could not open this repository on GitHub.${RESET}"
    echo
    echo "gh said: ${REPO_ERROR:-unknown error}"
    echo
    echo "None of your logged-in gh accounts can see it."
    echo "Check access with: gh auth status"
    echo

    exit 1

fi


# ------------------------------------------------------------
# User
# ------------------------------------------------------------

GH_USER=$(gh api user --jq '.login')


# ------------------------------------------------------------
# Build PR search
# ------------------------------------------------------------

SEARCH_BASE="repo:$REPO is:pr is:open sort:created-desc"

case "$FILTER" in

    all)
        SEARCH_QUERIES=("$SEARCH_BASE")
        ;;

    mine)
        SEARCH_QUERIES=("$SEARCH_BASE author:$GH_USER")
        ;;

    author)
        SEARCH_QUERIES=("$SEARCH_BASE$AUTHOR_QUALIFIERS")
        ;;

    review)
        # Every open PR you're a reviewer on. GitHub search has no
        # OR between these, so run both and merge:
        #   review-requested: asked to review, not reviewed yet
        #                     (GitHub drops the request once you do)
        #   reviewed-by:      any review you submitted, including
        #                     comments and reviews later dismissed
        # -author: skips your own PRs, where replying to review
        # comments also counts as "reviewed-by" you.
        SEARCH_QUERIES=(
            "$SEARCH_BASE review-requested:$GH_USER -author:$GH_USER"
            "$SEARCH_BASE reviewed-by:$GH_USER -author:$GH_USER"
        )
        ;;

esac


# ------------------------------------------------------------
# Fetch PR data in batches
#
# `gh pr list` asks for up to 100 PRs in one GraphQL request
# and can't be told to use smaller pages. Merge status + every
# check run for 50 PRs takes ~16s, and GitHub cuts GraphQL off
# at ~10s -> 504. So we page through ourselves, BATCH PRs per
# request, and halve the batch if a request still fails.
#
# CI uses the commit's overall statusCheckRollup state (the
# same pass/fail/pending GitHub shows) instead of fetching
# every individual check run, which is the other heavy part.
# ------------------------------------------------------------

# $q, $first, $after are GraphQL variables, not shell ones.
# shellcheck disable=SC2016
PR_QUERY='
query($q: String!, $first: Int!, $after: String) {
  search(query: $q, type: ISSUE, first: $first, after: $after) {
    pageInfo { hasNextPage endCursor }
    nodes {
      ... on PullRequest {
        number title url isDraft reviewDecision mergeable mergeStateStatus
        author { login }
        reviewRequests(first: 20) {
          nodes {
            requestedReviewer {
              ... on User { login }
              ... on Team { name }
              ... on Bot { login }
              ... on Mannequin { login }
            }
          }
        }
        latestReviews(first: 20) { nodes { author { login } state } }
        commits(last: 1) { nodes { commit { statusCheckRollup { state } } } }
      }
    }
  }
}'

# Reshape a search page into the same JSON shape `gh pr list`
# produced, so the rendering code below is unchanged.
PAGE_TO_PRS='
[
    .data.search.nodes[]
    | select(.number)
    | {
        number, title, url, isDraft, reviewDecision,
        mergeable, mergeStateStatus, author,
        reviewRequests: [
            .reviewRequests.nodes[].requestedReviewer
            | select(. != null)
            | {login: (.login // .name)}
        ],
        latestReviews: .latestReviews.nodes,
        statusCheckRollup: [
            .commits.nodes[0].commit.statusCheckRollup // empty
            | {state}
        ]
    }
]'

# Light search: only number and author, 100 per request. Fast,
# because GitHub doesn't compute mergeability or CI for it.
# shellcheck disable=SC2016
META_QUERY='
query($q: String!, $first: Int!, $after: String) {
  search(query: $q, type: ISSUE, first: $first, after: $after) {
    issueCount
    pageInfo { hasNextPage endCursor }
    nodes { ... on PullRequest { number author { __typename login } } }
  }
}'


# ------------------------------------------------------------
# Progress bar and --verbose log
#
# Both go to stderr, so the table on stdout stays clean when
# redirected. The bar is shown in a terminal; --verbose prints
# one line per step instead.
# ------------------------------------------------------------

SHOW_BAR=0
[[ -t 2 && "$VERBOSE" == 0 ]] && SHOW_BAR=1

# GH_DASHBOARD_PROGRESS=0 hides the bar; =1 shows it even when
# stderr isn't a terminal (the tests use this).
case "${GH_DASHBOARD_PROGRESS:-}" in
    0) SHOW_BAR=0 ;;
    1) [[ "$VERBOSE" == 0 ]] && SHOW_BAR=1 ;;
esac

now() { perl -MTime::HiRes=time -e 'printf "%.2f", time'; }

# Milliseconds since the epoch, optionally after sleeping
# SECONDS first (one process for both, which matters on Windows).
now_ms() { perl -MTime::HiRes=time,sleep -e 'sleep $ARGV[0]; printf "%d", time * 1000' "${1:-0}"; }

# Seconds since a now() timestamp, e.g. "2.4s".
elapsed() { perl -e 'printf "%.1fs", $ARGV[1] - $ARGV[0]' "$1" "$(now)"; }

vlog() {
    if [[ "$VERBOSE" == 1 ]]; then echo " $*" >&2; fi
    return 0
}

BAR_WIDTH=30
BAR_PARTS=("░" "▏" "▎" "▍" "▌" "▋" "▊" "▉")   # 0/8 .. 7/8 of a cell

# What's on screen. The bar never moves backwards, so a retry
# with a smaller batch, or an estimate that ran ahead, just
# holds it in place.
BAR_EIGHTHS=0
BAR_COUNT=0

# draw_bar EIGHTHS COUNT TOTAL: EIGHTHS of the BAR_WIDTH cells
# filled, in eighths of a cell for smooth movement.
draw_bar() {
    local eighths="$1" count="$2" total="$3" full i bar=""

    [[ "$eighths" -lt "$BAR_EIGHTHS" ]] && eighths="$BAR_EIGHTHS"
    [[ "$count" -lt "$BAR_COUNT" ]] && count="$BAR_COUNT"
    BAR_EIGHTHS="$eighths"
    BAR_COUNT="$count"

    full=$(( eighths / 8 ))
    for (( i = 0; i < full; i++ )); do bar="${bar}█"; done
    if [[ "$full" -lt "$BAR_WIDTH" ]]; then
        bar="$bar${BAR_PARTS[eighths % 8]}"
        for (( i = full + 1; i < BAR_WIDTH; i++ )); do bar="${bar}░"; done
    fi

    printf '\r Fetching PRs %s %d/%d' "$bar" "$count" "$total" >&2
}

# progress DONE TOTAL: jump to an exact count.
progress() {
    [[ "$SHOW_BAR" == 1 ]] || return 0
    local current="$1" total="$2"
    if [[ "$total" -le 0 ]]; then
        printf '\r Counting open PRs…' >&2
        return 0
    fi
    [[ "$current" -gt "$total" ]] && current="$total"
    draw_bar $(( current * BAR_WIDTH * 8 / total )) "$current" "$total"
}


# ------------------------------------------------------------
# Animating the bar during a request
#
# A detail request returns a whole batch at once, after a few
# seconds. Meanwhile the bar moves from where it is toward one
# PR short of the batch's end, at the expected speed, and holds
# there until the response arrives; then it jumps to the real
# count.
#
# Expected request time = FIXED_MS + MS_PER_PR x PRs, measured
# on this machine and network. The first two detail requests
# are small (1 and 5 PRs) so the fixed and per-PR costs can be
# told apart; after that both come from a best-fit line through
# every request so far. (The count request is cheaper than any
# detail request, so it only seeds the first guess.)
# ------------------------------------------------------------

ANIMATE=0
ANIM_BASE=0          # PRs fetched when the current request started
OVERHEAD_MS=0        # time of the count request
FIXED_MS=0           # fixed cost of a detail request
MS_PER_PR=250        # extra time per PR in a detail request
CALIBRATION_SIZES="" # sizes of the first detail requests, e.g. "1 5"

# Least-squares fit of request time (ms) against PRs requested.
FIT_K=0 FIT_SN=0 FIT_ST=0 FIT_SNN=0 FIT_SNT=0

# fit_add PRS MS: record a detail request and update the estimate.
fit_add() {
    local n="$1" t="$2" denominator
    FIT_K=$(( FIT_K + 1 ))
    FIT_SN=$(( FIT_SN + n ))
    FIT_ST=$(( FIT_ST + t ))
    FIT_SNN=$(( FIT_SNN + n * n ))
    FIT_SNT=$(( FIT_SNT + n * t ))
    denominator=$(( FIT_K * FIT_SNN - FIT_SN * FIT_SN ))

    if [[ "$denominator" -gt 0 ]]; then
        # Two or more sizes seen: slope and intercept of the fit.
        MS_PER_PR=$(( (FIT_K * FIT_SNT - FIT_SN * FIT_ST) / denominator ))
        [[ "$MS_PER_PR" -lt 20 ]] && MS_PER_PR=20
        FIXED_MS=$(( (FIT_ST - MS_PER_PR * FIT_SN) / FIT_K ))
    else
        # One size only: assume half of what this request cost
        # beyond the count request scales with the PRs.
        MS_PER_PR=$(( (t - OVERHEAD_MS) / 2 / n ))
        [[ "$MS_PER_PR" -lt 20 ]] && MS_PER_PR=20
        FIXED_MS=$(( t - MS_PER_PR * n ))
    fi
    [[ "$FIXED_MS" -lt 0 ]] && FIXED_MS=0
    return 0
}

# animate_frame ELAPSED_MS FIRST
animate_frame() {
    local elapsed="$1" first="$2" expected target

    expected=$(( FIXED_MS + MS_PER_PR * first ))
    [[ "$expected" -gt 0 ]] || expected=1
    [[ "$elapsed" -gt "$expected" ]] && elapsed="$expected"

    target=$(( ANIM_BASE + first - 1 ))
    [[ "$target" -ge "$TOTAL" ]] && target=$(( TOTAL - 1 ))
    [[ "$target" -lt "$ANIM_BASE" ]] && target="$ANIM_BASE"

    draw_bar \
        $(( (ANIM_BASE * expected + (target - ANIM_BASE) * elapsed) * BAR_WIDTH * 8 / (TOTAL * expected) )) \
        $(( ANIM_BASE + (target - ANIM_BASE) * elapsed / expected )) \
        "$TOTAL"
}

# Background requests write here. Removed after the fetch, before
# exiting on an error, and on Ctrl-C.
#
# Deliberately no "trap ... EXIT": in bash 3.2 an EXIT trap makes a
# script that dies on an error (e.g. an unbound variable under set
# -u) exit with status 0, hiding the failure.
PAGE_FILE=""
cleanup() {
    if [[ -n "$PAGE_FILE" ]]; then rm -f "$PAGE_FILE"; fi
    PAGE_FILE=""
    return 0
}
trap 'cleanup; exit 130' INT
trap 'cleanup; exit 143' TERM

# run_search QUERY SEARCH FIRST CURSOR: one search request.
run_search() {
    gh api graphql \
        -f query="$1" \
        -f q="$2" \
        -F first="$3" \
        ${4:+-f after="$4"}
}

progress_clear() {
    if [[ "$SHOW_BAR" == 1 ]]; then printf '\r\033[K' >&2; fi
    return 0
}


# ------------------------------------------------------------
# fetch_page QUERY SEARCH FIRST CURSOR
#
# One search page, up to 4 attempts, halving the page size
# after each failure. Sets PAGE (the response), PAGE_FIRST (the
# size that worked) and PAGE_TIME (with --verbose). Exits with
# GitHub's error if every attempt fails.
# ------------------------------------------------------------

fetch_page() {
    local query="$1" search="$2" first="$3" cursor="$4"
    local attempt=1 started="" ok pid start_ms now_ms_value

    while true; do

        [[ "$VERBOSE" == 1 ]] && started=$(now)

        if [[ "$ANIMATE" == 1 ]]; then

            # Request in the background; animate until it's done.
            [[ -n "$PAGE_FILE" ]] || PAGE_FILE=$(mktemp)
            start_ms=$(now_ms)
            run_search "$query" "$search" "$first" "$cursor" > "$PAGE_FILE" 2>&1 &
            pid=$!
            now_ms_value="$start_ms"
            while kill -0 "$pid" 2>/dev/null; do
                animate_frame $(( now_ms_value - start_ms )) "$first"
                now_ms_value=$(now_ms 0.1)
            done
            if wait "$pid"; then ok=1; else ok=0; fi
            PAGE=$(cat "$PAGE_FILE")

            PAGE_MS=$(( $(now_ms) - start_ms ))

        else

            if PAGE=$(run_search "$query" "$search" "$first" "$cursor" 2>&1); then ok=1; else ok=0; fi

        fi

        if [[ "$ok" == 1 ]]; then
            PAGE_FIRST="$first"
            PAGE_TIME=""
            [[ "$VERBOSE" == 1 ]] && PAGE_TIME=$(elapsed "$started")
            return 0
        fi

        if [[ "$attempt" -ge 4 ]]; then
            progress_clear
            cleanup
            echo
            echo "${RED}Fetching PRs failed after $attempt attempts.${RESET}"
            echo
            echo "$PAGE" | tail -3
            echo
            exit 1
        fi

        attempt=$(( attempt + 1 ))
        first=$(( first > 1 ? first / 2 : 1 ))
        vlog "  request failed ($(echo "$PAGE" | tail -1)), retrying with $first"

    done
}


# ------------------------------------------------------------
# search_meta WITH_AUTHORS
#
# Sets QUERY_TOTALS: GitHub's match count for each search. With
# WITH_AUTHORS=1 it also pages through every match (number and
# author only) and sets META to [{number, login, bot}], one per
# PR. Without, it asks for a single PR per search: just enough
# to read the count.
# ------------------------------------------------------------

search_meta() {
    local with_authors="$1" search cursor first=1 pages=""
    [[ "$with_authors" == 1 ]] && first=100

    QUERY_TOTALS=""

    for search in "${SEARCH_QUERIES[@]}"; do

        cursor=""

        while true; do

            fetch_page "$META_QUERY" "$search" "$first" "$cursor"

            if [[ -z "$cursor" ]]; then
                QUERY_TOTALS="$QUERY_TOTALS $(echo "$PAGE" | jq '.data.search.issueCount')"
            fi

            [[ "$with_authors" == 1 ]] || break

            pages="$pages$(echo "$PAGE" | jq -c '[
                .data.search.nodes[] | select(.number)
                | {number, login: .author.login, bot: (.author.__typename == "Bot")}
            ]')"$'\n'

            cursor=$(echo "$PAGE" | jq -r '
                .data.search.pageInfo
                | if .hasNextPage then .endCursor else empty end
            ')

            [[ -z "$cursor" ]] && break

        done

    done

    META=$(printf '%s' "$pages" | jq -s 'add // [] | unique_by(.number)')
}

# plural N WORD: "1 PR", "3 PRs".
plural() {
    if [[ "$1" == 1 ]]; then echo "$1 $2"; else echo "$1 $2s"; fi
}

# Authors in META with their PR counts, most PRs first, as
# "count<TAB>name" lines. Deleted accounts come last.
author_counts() {
    echo "$META" | jq -r '
        group_by(.login)
        | map({login: .[0].login, bot: .[0].bot, n: length})
        | sort_by(-.n, (.login == null), (.login // "" | ascii_downcase))
        | .[]
        | "\(.n)\t\(
            if .login == null then "(deleted user)"
            elif .bot then "\(.login) (bot)"
            else .login end)"
    '
}


# ------------------------------------------------------------
# First pass: totals (for the progress bar) and, with --verbose
# or --author-list, every PR's author. Skipped when nothing
# would show it (output piped, no --verbose).
# ------------------------------------------------------------

NEED_AUTHORS=0
[[ "$VERBOSE" == 1 || "$AUTHOR_LIST" == 1 ]] && NEED_AUTHORS=1

TOTAL=0

if [[ "$NEED_AUTHORS" == 1 || "$SHOW_BAR" == 1 ]]; then

    for SEARCH_QUERY in "${SEARCH_QUERIES[@]}"; do
        vlog "Search: $SEARCH_QUERY"
    done

    progress 0 0
    COUNT_STARTED=$(now_ms)
    search_meta "$NEED_AUTHORS"
    # One request per search: their average is the fixed cost.
    OVERHEAD_MS=$(( ($(now_ms) - COUNT_STARTED) / ${#SEARCH_QUERIES[@]} ))

    # What the detail fetch will request: each search up to LIMIT.
    for COUNT in $QUERY_TOTALS; do
        TOTAL=$(( TOTAL + (COUNT < LIMIT ? COUNT : LIMIT) ))
    done

fi

if [[ "$NEED_AUTHORS" == 1 ]]; then

    MATCH_COUNT=$(echo "$META" | jq 'length')
    AUTHOR_COUNT=$(author_counts | wc -l | tr -d ' ')

    SUMMARY=$(author_counts | awk -F'\t' '
        NR <= 5 { out = out (NR > 1 ? ", " : "") $2 " " $1 }
        END     { if (NR > 5) out = out ", … (+" NR - 5 " more)"; print out }
    ')

    vlog "Found $(plural "$MATCH_COUNT" "open PR") by $(plural "$AUTHOR_COUNT" author)${SUMMARY:+: $SUMMARY}"

    if [[ "$MATCH_COUNT" -gt "$LIMIT" && "$AUTHOR_LIST" == 0 ]]; then
        vlog "Showing the newest $LIMIT (GH_DASHBOARD_LIMIT)"
    fi

fi


# ------------------------------------------------------------
# --author-list: print the authors and stop, without fetching
# the (much slower) PR details.
# ------------------------------------------------------------

if [[ "$AUTHOR_LIST" == 1 ]]; then

    progress_clear

    echo
    printf " %sOpen PR authors%s — %s%s%s\n" "$BOLD$CYAN" "$RESET" "$BOLD" "$REPO" "$RESET"

    FILTER_NOTE=""
    [[ -n "$FILTER_OPTION" && "$FILTER" != "all" ]] && FILTER_NOTE="   Filter: $FILTER_OPTION${AUTHORS:+ $AUTHORS}"
    printf " %s%s by %s%s%s\n" "$DIM" "$(plural "$MATCH_COUNT" PR)" "$(plural "$AUTHOR_COUNT" author)" "$FILTER_NOTE" "$RESET"

    echo
    printf " %s%5s  %s%s\n" "$BOLD" "PRS" "AUTHOR" "$RESET"

    author_counts | while IFS=$'\t' read -r COUNT NAME; do
        printf " %5s  %s\n" "$COUNT" "$NAME"
    done

    echo

    if [[ "$USE_COLOR" == 1 ]]; then
        printf ' %s\n\n' "${DIM}Show one author's PRs: gh dashboard --author <name>${RESET}"
    fi

    exit 0

fi


# ------------------------------------------------------------
# Detail fetch, BATCH PRs per request
# ------------------------------------------------------------

PAGE_SIZE="$BATCH"
PAGES=""
TOTAL_FETCHED=0
BATCH_NUMBER=0
FETCH_STARTED=""

if [[ "$VERBOSE" == 1 ]]; then
    FETCH_STARTED=$(now)
    vlog "Fetching details, $BATCH PRs per request"
fi

# Animate the bar only when there's a bar and a known total.
if [[ "$SHOW_BAR" == 1 && "$TOTAL" -gt 0 ]]; then
    ANIMATE=1
    CALIBRATION_SIZES="1 5"
    FIXED_MS="$OVERHEAD_MS"
fi

for SEARCH_QUERY in "${SEARCH_QUERIES[@]}"; do

    FETCHED=0
    CURSOR=""

    while (( FETCHED < LIMIT )); do

        FIRST=$(( LIMIT - FETCHED < PAGE_SIZE ? LIMIT - FETCHED : PAGE_SIZE ))
        # Calibration: the first detail requests are small.
        NEXT_SIZE="${CALIBRATION_SIZES%% *}"
        if [[ -n "$NEXT_SIZE" && "$NEXT_SIZE" -lt "$FIRST" ]]; then FIRST="$NEXT_SIZE"; fi

        progress "$TOTAL_FETCHED" "$TOTAL"

        ANIM_BASE="$TOTAL_FETCHED"
        fetch_page "$PR_QUERY" "$SEARCH_QUERY" "$FIRST" "$CURSOR"

        if [[ "$ANIMATE" == 1 ]]; then
            fit_add "$PAGE_FIRST" "$PAGE_MS"
            case "$CALIBRATION_SIZES" in
                *" "*) CALIBRATION_SIZES="${CALIBRATION_SIZES#* }" ;;
                *)     CALIBRATION_SIZES="" ;;
            esac
        fi

        # After a failure the batch shrank: grow it back toward
        # BATCH, doubling with each request that works.
        [[ "$PAGE_FIRST" -lt "$FIRST" ]] && PAGE_SIZE="$PAGE_FIRST"
        PAGE_SIZE=$(( PAGE_SIZE * 2 < BATCH ? PAGE_SIZE * 2 : BATCH ))

        PAGE_PRS=$(echo "$PAGE" | jq -c "$PAGE_TO_PRS")
        PAGES="${PAGES}${PAGE_PRS}"$'\n'
        PAGE_COUNT=$(echo "$PAGE_PRS" | jq 'length')
        FETCHED=$(( FETCHED + PAGE_COUNT ))
        TOTAL_FETCHED=$(( TOTAL_FETCHED + PAGE_COUNT ))

        BATCH_NUMBER=$(( BATCH_NUMBER + 1 ))
        vlog "  batch $BATCH_NUMBER: $PAGE_COUNT PRs in $PAGE_TIME ($TOTAL_FETCHED${TOTAL:+/$TOTAL})"

        CURSOR=$(echo "$PAGE" | jq -r '
            .data.search.pageInfo
            | if .hasNextPage then .endCursor else empty end
        ')

        [[ -z "$CURSOR" ]] && break

    done

done

progress_clear
cleanup

if [[ "$VERBOSE" == 1 ]]; then
    vlog "Fetched $TOTAL_FETCHED PRs in $(elapsed "$FETCH_STARTED")"
fi

if [[ "${#SEARCH_QUERIES[@]}" -gt 1 ]]; then
    # Several searches can return the same PR: keep one copy,
    # newest (highest number) first, at most LIMIT.
    PRS=$(printf '%s' "$PAGES" | jq -s --argjson limit "$LIMIT" '
        add // [] | unique_by(.number) | sort_by(-.number) | .[:$limit]
    ')
else
    PRS=$(printf '%s' "$PAGES" | jq -s 'add // []')
fi


PR_COUNT=$(echo "$PRS" | jq 'length')


# ------------------------------------------------------------
# Header
# ------------------------------------------------------------

echo

printf " %sGitHub PR Dashboard%s — %s%s%s\n" "$BOLD$CYAN" "$RESET" "$BOLD" "$REPO" "$RESET"

printf " %sUpdated: %s   PRs: %s%s\n" \
    "$DIM" \
    "$(date '+%H:%M:%S')" \
    "$PR_COUNT" \
    "$RESET"

echo


# ------------------------------------------------------------
# Column widths
# ------------------------------------------------------------

row \
    "${BOLD}#" \
    "PR" \
    "AUTHOR" \
    "REVIEWERS" \
    "CI" \
    "APPROVALS" \
    "MERGE${RESET}"

# Separator spans all columns + the single spaces between them.
# (Built with printf, not tr: tr is byte-based and mangles ─.)
TABLE_WIDTH=$(( $(echo "$COL_WIDTHS" | tr ',' '+') + $(echo "$COL_WIDTHS" | tr -cd ',' | wc -c) ))
printf '─%.0s' $(seq 1 "$TABLE_WIDTH")
echo


# ------------------------------------------------------------
# Process each PR
# ------------------------------------------------------------

echo "$PRS" | jq -c '.[]' | while read -r PR; do

    NUMBER=$(echo "$PR" | jq -r '.number')

    TITLE=$(echo "$PR" | jq -r '.title')

    AUTHOR=$(echo "$PR" | jq -r '.author.login // "—"')

    URL=$(echo "$PR" | jq -r '.url')

    IS_DRAFT=$(echo "$PR" | jq -r '.isDraft')

    MERGEABLE=$(echo "$PR" | jq -r '.mergeable')

    MERGE_STATE=$(echo "$PR" | jq -r '.mergeStateStatus // "UNKNOWN"')

    REVIEW_DECISION=$(echo "$PR" | jq -r '.reviewDecision // "UNKNOWN"')


    # --------------------------------------------------------
    # Draft
    # --------------------------------------------------------

    if [[ "$IS_DRAFT" == "true" ]]; then
        TITLE="${TITLE} [DRAFT]"
    fi


    # --------------------------------------------------------
    # Reviewers
    #
    # We combine:
    #   reviewRequests
    #   latestReviews
    #
    # This means we can show both pending reviewers and
    # reviewers who already submitted a review.
    # --------------------------------------------------------

    REVIEWERS=$(
        echo "$PR" | jq -r '

        (
            [
                .reviewRequests[]?.login,
                .latestReviews[]?.author.login
            ]
            | unique
        ) as $users |

        . as $pr |

        [
            $users[] |
            . as $login |

            (
                [
                    $pr.latestReviews[]?
                    | select(.author.login == $login)
                    | .state
                ][0] // "PENDING"
            ) as $state |

            if $state == "APPROVED"
            then "APPROVED:\($login)"

            elif $state == "CHANGES_REQUESTED"
            then "CHANGES:\($login)"

            elif $state == "COMMENTED"
            then "COMMENTED:\($login)"

            else
                "PENDING:\($login)"
            end
        ]
        | join("|")
        '
    )


    # --------------------------------------------------------
    # Render reviewer statuses
    # --------------------------------------------------------

    REVIEWER_DISPLAY=""

    IFS='|' read -ra REVIEWER_ARRAY <<< "$REVIEWERS"

    for REVIEWER in ${REVIEWER_ARRAY[@]+"${REVIEWER_ARRAY[@]}"}; do

        [[ -z "$REVIEWER" ]] && continue

        STATE="${REVIEWER%%:*}"
        USER="${REVIEWER#*:}"

        case "$STATE" in

            APPROVED)
                ITEM="${GREEN}✓ ${USER}${RESET}"
                ;;

            CHANGES)
                ITEM="${RED}✗ ${USER}${RESET}"
                ;;

            COMMENTED)
                ITEM="${ORANGE}💬 ${USER}${RESET}"
                ;;

            PENDING)
                ITEM="${YELLOW}◷ ${USER}${RESET}"
                ;;

            *)
                ITEM="${DIM}? ${USER}${RESET}"
                ;;

        esac

        if [[ -z "$REVIEWER_DISPLAY" ]]; then
            REVIEWER_DISPLAY="$ITEM"
        else
            REVIEWER_DISPLAY="$REVIEWER_DISPLAY $ITEM"
        fi

    done


    if [[ -z "$REVIEWER_DISPLAY" ]]; then
        REVIEWER_DISPLAY="${DIM}—${RESET}"
    fi


    # --------------------------------------------------------
    # Approval count
    # --------------------------------------------------------

    APPROVED_COUNT=$(
        echo "$PR" |
        jq '[.latestReviews[]? | select(.state == "APPROVED")] | length'
    )

    # --------------------------------------------------------
    # Total reviewers = pending requests + anyone who already
    # reviewed (GitHub drops a reviewer from reviewRequests
    # once they submit a review). Same set as REVIEWERS.
    # --------------------------------------------------------

    REVIEWER_COUNT=$(
        echo "$PR" |
        jq '[.reviewRequests[]?.login, .latestReviews[]?.author.login] | unique | length'
    )

    APPROVAL_DISPLAY="${APPROVED_COUNT}/${REVIEWER_COUNT}"


    if [[ "$REVIEW_DECISION" == "APPROVED" ]]; then
        APPROVAL_DISPLAY="${GREEN}${APPROVAL_DISPLAY}${RESET}"

    elif [[ "$REVIEW_DECISION" == "CHANGES_REQUESTED" ]]; then
        APPROVAL_DISPLAY="${RED}${APPROVAL_DISPLAY}${RESET}"

    else
        APPROVAL_DISPLAY="${YELLOW}${APPROVAL_DISPLAY}${RESET}"
    fi


    # --------------------------------------------------------
    # CI
    #
    # statusCheckRollup holds the commit's overall rollup state
    # (see PAGE_TO_PRS). The conclusion/status branches also
    # accept per-check entries, the shape `gh pr list` returns.
    # --------------------------------------------------------

    CI_RESULT=$(
        echo "$PR" | jq -r '

        [
            .statusCheckRollup[]? |

            (
                (.conclusion // "") |
                ascii_upcase
            ) as $conclusion |

            (
                (.status // .state // "") |
                ascii_upcase
            ) as $state |

            if $conclusion == "FAILURE"
                or $conclusion == "TIMED_OUT"
                or $conclusion == "CANCELLED"
                or $conclusion == "ACTION_REQUIRED"
            then "FAIL"

            elif $state == "FAILURE"
                or $state == "ERROR"
            then "FAIL"

            elif $state == "IN_PROGRESS"
                or $state == "QUEUED"
                or $state == "PENDING"
                or $state == "EXPECTED"
                or $state == "WAITING"
            then "PENDING"

            elif $conclusion == "SUCCESS"
                or $conclusion == "NEUTRAL"
                or $conclusion == "SKIPPED"
                or $state == "SUCCESS"
            then "PASS"

            else
                "UNKNOWN"
            end
        ]
        | if any(.[]; . == "FAIL")
            then "FAIL"
          elif any(.[]; . == "PENDING")
            then "PENDING"
          elif length == 0
            then "NONE"
          elif all(.[]; . == "PASS")
            then "PASS"
          else
            "UNKNOWN"
          end
        '
    )


    case "$CI_RESULT" in

        PASS)
            CI_DISPLAY="${GREEN}✓ PASS${RESET}"
            ;;

        FAIL)
            CI_DISPLAY="${RED}✗ FAIL${RESET}"
            ;;

        PENDING)
            CI_DISPLAY="${YELLOW}◷ RUN${RESET}"
            ;;

        NONE)
            CI_DISPLAY="${DIM}— NONE${RESET}"
            ;;

        *)
            CI_DISPLAY="${DIM}? UNKNOWN${RESET}"
            ;;

    esac


    # --------------------------------------------------------
    # MERGE STATUS
    #
    # This is intentionally synthesized rather than simply
    # printing mergeStateStatus.
    #
    # Priority:
    #
    # DRAFT
    # CONFLICT
    # CI FAIL
    # CHANGES REQUESTED
    # REVIEW REQUIRED
    # CI PENDING
    # BLOCKED
    # READY
    # --------------------------------------------------------

    if [[ "$IS_DRAFT" == "true" ]]; then

        MERGE_STATUS="DRAFT"
        MERGE_COLOR="$YELLOW"
        MERGE_ICON="◷"

    elif [[ "$MERGEABLE" == "CONFLICTING" ]]; then

        MERGE_STATUS="CONFLICT"
        MERGE_COLOR="$RED"
        MERGE_ICON="✗"

    elif [[ "$CI_RESULT" == "FAIL" ]]; then

        MERGE_STATUS="CI FAIL"
        MERGE_COLOR="$RED"
        MERGE_ICON="✗"

    elif [[ "$REVIEW_DECISION" == "CHANGES_REQUESTED" ]]; then

        MERGE_STATUS="CHANGES"
        MERGE_COLOR="$RED"
        MERGE_ICON="✗"

    elif [[ "$REVIEW_DECISION" == "REVIEW_REQUIRED" ]]; then

        MERGE_STATUS="REVIEW"
        MERGE_COLOR="$YELLOW"
        MERGE_ICON="◷"

    elif [[ "$CI_RESULT" == "PENDING" ]]; then

        MERGE_STATUS="CI RUN"
        MERGE_COLOR="$YELLOW"
        MERGE_ICON="◷"

    elif [[ "$MERGE_STATE" == "BLOCKED" ]]; then

        MERGE_STATUS="BLOCKED"
        MERGE_COLOR="$RED"
        MERGE_ICON="✗"

    elif [[ "$MERGEABLE" == "MERGEABLE" ]]; then

        MERGE_STATUS="READY"
        MERGE_COLOR="$GREEN"
        MERGE_ICON="✓"

    else

        MERGE_STATUS="$MERGE_STATE"
        MERGE_COLOR="$DIM"
        MERGE_ICON="?"

    fi


    MERGE_DISPLAY="${MERGE_COLOR}${MERGE_ICON} ${MERGE_STATUS}${RESET}"


    # --------------------------------------------------------
    # Clickable PR link
    # --------------------------------------------------------

    row \
        "#${NUMBER}" \
        "$(link "$URL" "$TITLE")" \
        "$AUTHOR" \
        "$REVIEWER_DISPLAY" \
        "$CI_DISPLAY" \
        "$APPROVAL_DISPLAY" \
        "$MERGE_DISPLAY"

done


# ------------------------------------------------------------
# Legend
# ------------------------------------------------------------

echo

printf ' %s ' "${DIM}Legend:${RESET}"
printf '%s  ' "${GREEN}✓ Approved${RESET}"
printf '%s  ' "${YELLOW}◷ Pending${RESET}"
printf '%s  ' "${RED}✗ Changes/Problem${RESET}"
printf '%s' "${ORANGE}💬 Comment${RESET}"

echo

if [[ "$USE_COLOR" == 1 ]]; then
    echo
    printf ' %s\n' "${DIM}Click a PR title to open it in your browser.${RESET}"
fi

echo

